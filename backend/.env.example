# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Webcam source APIs ---
# Windy.com Webcams API (https://api.windy.com/webcams/docs) - primary source.
# Free tier key from https://api.windy.com/keys
WINDY_WEBCAMS_API_KEY=

# Optional additional source (structured the same way - add real key to enable).
# Example placeholder for a second webcam directory API, wired through the same
# adapter interface as Windy so it can be turned on with a key alone.
SECONDARY_WEBCAM_API_KEY=

# Weather for the "Surprise Me" page (OpenWeatherMap - free tier).
OPENWEATHER_API_KEY=

# SQLite file location
DB_PATH=./data/cameras.db

# Discovery scheduler
DISCOVERY_REFRESH_CRON=0 */6 * * *
AVAILABILITY_CHECK_CRON=*/15 * * * *
